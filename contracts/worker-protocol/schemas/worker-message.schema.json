{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.spokenbase.dev/worker-protocol/v1/worker-message.schema.json",
  "title": "Spokenbase worker protocol message",
  "description": "Milestone 0 envelope for versioned API-to-worker messages.",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageId",
    "messageType",
    "createdAt",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1"
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "messageType": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "x-spdx-license-identifier": "Apache-2.0"
}
