FROM python:3.12-slim

RUN useradd --create-home --uid 10001 spokenbase
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

USER spokenbase
CMD ["python", "-c", "import spokenbase_worker; print(spokenbase_worker.__version__)"]
