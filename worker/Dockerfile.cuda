# SPDX-License-Identifier: AGPL-3.0-only

# The CUDA runtime and model dependencies will be pinned once the first local
# transcription implementation is accepted. Milestone 0 keeps the build target
# explicit without pretending GPU support is complete.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 spokenbase

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip3 install --break-system-packages --no-cache-dir .

USER spokenbase
CMD ["python3", "-c", "import spokenbase_worker; print(spokenbase_worker.__version__)"]
