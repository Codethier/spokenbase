# SPDX-License-Identifier: AGPL-3.0-only

# The CUDA runtime and model dependencies will be pinned once the first local
# transcription implementation is accepted. Milestone 0 keeps the build target
# explicit without pretending GPU support is complete.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ffmpeg python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 spokenbase

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WORKER_HTTP_HOST=0.0.0.0

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip3 install --break-system-packages --no-cache-dir .

USER spokenbase
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2)"]
CMD ["python3", "-m", "spokenbase_worker"]
