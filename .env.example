# Reference Compose development settings. Do not use plaintext broker access
# outside the trusted local Compose network.
REDPANDA_VERSION=v26.1.14
REDPANDA_CONSOLE_VERSION=v3.9.0
REDPANDA_BROKERS=localhost:19092
REDPANDA_TOPIC_PARTITIONS=6
REDPANDA_TOPIC_REPLICAS=1
REDPANDA_MEMORY_LIMIT=2g

WORKER_QUEUE_ENABLED=true
WORKER_ALLOW_INSECURE_REDPANDA=true
WORKER_ID=spokenbase-worker-cpu
WORKER_HTTP_PORT=18080
